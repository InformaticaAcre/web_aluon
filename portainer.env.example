# Copia este archivo como `portainer.env` y rellena valores.
# Úsalo con `docker-compose.portainer.yml` (vía Portainer por Git/Repo o desplegando en host).
#
# Imágenes publicadas (ver `scripts/publish-images.sh`)
ALUON_FRONTEND_IMAGE=ghcr.io/ORG/aluon-frontend:1.0.0
ALUON_BACKEND_IMAGE=ghcr.io/ORG/aluon-backend:0.1.0

# Backend (Spring Boot)
SPRING_DATASOURCE_URL=jdbc:postgresql://192.168.99.14:5433/aluon_saas_dev
SPRING_DATASOURCE_USERNAME=admin_dev
SPRING_DATASOURCE_PASSWORD=admin_dev_password_secure

# Flyway / schema isolation (opcionales)
APP_DB_SCHEMA=aluon_web
SPRING_FLYWAY_TABLE=flyway_schema_history_aluon_web

# Seguridad / CORS
# Mínimo 32 caracteres
APP_JWT_SECRET=aluon_jwt_secret_change_me_please_min_32_chars_2026
# Origen permitido del frontend (cuando accedes por IP y puerto)
APP_CORS_ALLOWED_ORIGINS=http://192.168.99.14:8010
